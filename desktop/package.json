{
  "name": "wavo-desktop",
  "productName": "WAVO",
  "version": "1.0.0",
  "private": true,
  "description": "WAVO — native Windows desktop shell",
  "author": "WAVO",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "icon": "electron tools/make-icon.cjs",
    "stage": "node tools/stage.cjs",
    "dist": "npm run stage && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run stage && electron-builder --win --dir --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
